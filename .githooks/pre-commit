#!/bin/sh
# Коммиты в doska делает координатор волны (или владелец). Субагенты
# работают в дереве, но коммитов не создают: волну собирает один, кто
# видел всю картину. Обход для координатора: DOSKA_COORDINATOR=1.
# Разово — git commit --no-verify.

if [ "${DOSKA_COORDINATOR:-}" != "1" ]; then
  echo "отклонено: коммиты делает координатор волны (DOSKA_COORDINATOR=1 git commit ...)" >&2
  exit 1
fi
